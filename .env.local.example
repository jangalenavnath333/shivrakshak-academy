# Supabase (https://supabase.com वरून मिळवा)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# WhatsApp - Twilio (https://twilio.com वरून मिळवा)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_LEAVE_CONFIRMATION_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_LEAVE_RETURN_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ADMISSION_ACTIVATED_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace-with-a-random-string-at-least-16-characters
ADMISSION_CREDENTIAL_SECRET=replace-with-a-random-string-at-least-32-characters
ADMISSION_PRINT_TOKEN_SECRET=replace-with-a-different-random-string-at-least-32-characters

# Transactional email (server-only).
# Resend is used when RESEND_API_KEY is set; otherwise Gmail SMTP is used.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Shivrakshak Academy <noreply@your-verified-domain.com>

# Gmail SMTP fallback — GMAIL_APP_PASSWORD is a 16-character Google App Password
# (https://myaccount.google.com/apppasswords), not the account password.
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_FROM=Shivrakshak Career Academy <your-account@gmail.com>
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Keep disabled in normal operation. Temporarily enable only for an authenticated admin setup session.
ALLOW_ADMIN_SETUP=false
